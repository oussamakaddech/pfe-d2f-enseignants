    print("\n[2] Vérification anti-fuite...")
    leaks = [c for c in FEATURE_COLS if c in FORBIDDEN_IN_X]
    assert not leaks, f"Fuite détectée : {leaks}"
    print("    OK : required_level et gap_next_3m exclus des features")

