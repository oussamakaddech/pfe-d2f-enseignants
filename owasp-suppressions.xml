<?xml version="1.0" encoding="UTF-8"?>
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">
    <!--
      DOMPurify est embarqué en tant que ressource statique JS dans le webjar
      org.webjars:swagger-ui (springdoc-openapi) : servi uniquement pour
      l'interface de documentation OpenAPI. Le CPE NVD
      cpe:2.3:a:cure53:dompurify n'a aucune borne de version (toutes les
      versions sont déclarées affectées) : aucune mise à jour ne peut lever
      cette alerte. Risque accepté et documenté (revue DSI 12.12).
    -->
    <suppress>
        <notes>DOMPurify statique embarqué dans swagger-ui (webjar) - CPE NVD sans borne de version, aucune version corrigée disponible.</notes>
        <packageUrl regex="true">^pkg:javascript/DOMPurify@.*</packageUrl>
    </suppress>
</suppressions>
