# ──────────────────────────────────────────────────────────────────────────────
# .env.example — Plateforme D2F
# Copier ce fichier en .env : cp .env.example .env
# Puis lancer : docker compose up -d
# ──────────────────────────────────────────────────────────────────────────────

# ── Base de données (PostgreSQL) ─────────────────────────────────────────────
POSTGRES_USER=d2f
POSTGRES_PASSWORD=d2fpasswd
POSTGRES_DB=d2f

DB_URL=jdbc:postgresql://localhost:7432/d2f
DB_PASSWORD=d2fpasswd

# Utilisateurs PostgreSQL par service
DB_USER_AUTH=app_user_auth
DB_USER_COMPETENCE=app_user_competence
DB_USER_FORMATION=app_user_formation
DB_USER_EVALUATION=app_user_evaluation
DB_USER_CERTIFICAT=app_user_certificat
DB_USER_BESOIN=app_user_besoinsformation
DB_USER_ANALYSE=app_user_analyse
DB_USER_NOTIFICATION=app_user_notification
DB_USER_RICE=app_user_rice
# Un mot de passe par service ; défaut = DB_PASSWORD si non renseigné
DB_PASSWORD_AUTH=
DB_PASSWORD_FORMATION=
DB_PASSWORD_BESOIN=
DB_PASSWORD_EVALUATION=
DB_PASSWORD_CERTIFICAT=
DB_PASSWORD_COMPETENCE=
DB_PASSWORD_ANALYSE=
DB_PASSWORD_NOTIFICATION=
DB_PASSWORD_RICE=

# ── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=                             # ← REMPLIR : générer avec openssl rand -base64 64

# ── Sécurité — Admin par défaut ──────────────────────────────────────────────
APP_SECURITY_DEFAULT_ADMIN_USERNAME=admin
APP_SECURITY_DEFAULT_ADMIN_PASSWORD=  # OBLIGATOIRE : mot de passe fort, ne jamais laisser "admin"

# ── RabbitMQ ─────────────────────────────────────────────────────────────────
RABBITMQ_HOST=broker.dsi.local
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=d2f
RABBITMQ_USER=d2f
RABBITMQ_PASSWORD=d2fpasswd

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGIN_WEBAPP=http://localhost:5173
CORS_ORIGIN_WEBAPP_ALT=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Mail (SMTP) ─────────────────────────────────────────────────────────────
MAIL_HOST=smtp.office365.com
MAIL_PORT=587
MAIL_USERNAME=                          # ← REMPLIR : adresse SMTP institutionnelle
MAIL_PASSWORD=                          # ← REMPLIR : mot de passe SMTP
MAIL_FROM=noreply@d2f.tn
ADMIN_EMAIL=admin@d2f.tn
FORMATION_ORGANIZER_EMAIL=noreply@d2f.tn

# ── Azure AD (désactivé par défaut) ──────────────────────────────────────────
AZURE_AD_ENABLED=false
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=
AZURE_AD_GRAPH_SCOPE=https://graph.microsoft.com/.default
AZURE_AD_MAIL_USERNAME=
AZURE_AD_MAIL_PASSWORD=

# ── Frontend (Vite) ─────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:8080/api
VITE_RICE_URL=http://localhost:8001
# Notifications : base REST optionnelle (défaut = gateway VITE_API_URL).
# WebSocket optionnel pour le push temps réel (laisser vide = mode REST).
VITE_NOTIFICATION_URL=http://localhost:8080/api
VITE_NOTIFICATIONS_WS_URL=ws://localhost:8009/ws/notifications

# ── Services URLs (inter-services) ───────────────────────────────────────────
AUTH_SERVICE_URL=http://d2f-auth:8085
EVALUATION_SERVICE_URL=http://d2f-evaluation:8087
FORMATION_SERVICE_URL=http://d2f-formation:8088
COMPETENCE_SERVICE_URL=http://d2f-competence:8005
BESOIN_SERVICE_URL=http://d2f-besoin-formation:8004
CERTIFICAT_SERVICE_URL=http://d2f-certificat:8086
ANALYSE_SERVICE_URL=http://d2f-predictive-analytics:8000
SKILL_PASSPORT_SERVICE_URL=http://d2f-analyse:8089
RICE_SERVICE_URL=http://d2f-rice:8001
NOTIFICATION_SERVICE_URL=http://d2f-notification:8009

# ── Predictive Analytics ─────────────────────────────────────────────────────
SEUIL_GAP_CRITIQUE=0.75
SEUIL_GAP_HAUTE=0.50
SEUIL_STAGNATION_MOIS=12
SEUIL_COMPLETION_FAIBLE=40.0
SCHEDULER_ENABLED=true
BATCH_ANALYSIS_HOUR=2
DASHBOARD_REFRESH_HOUR=3
MESSAGING_ENABLED=false

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=                         # ← REMPLIR : mot de passe Redis

# ── PgAdmin (debug) ──────────────────────────────────────────────────────────
PGADMIN_EMAIL=admin@d2f.tn
PGADMIN_PASSWORD=d2fpasswd
