# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
DB_NAME=d2f
DB_USER=d2f
DB_PASS=CHANGE_ME_STRONG_PASSWORD
DB_HOST=localhost
DB_PORT=7432

# ── JWT Authentication ───────────────────────────────────────────────────────
# Activer l'authentification JWT en production (recommandé: true)
RICE_AUTH_ENABLED=false
# Secret JWT HS512 (min 64 caractères) — requis si RICE_AUTH_ENABLED=true
# RICE_AUTH_SECRET=change-me-generate-with-openssl-rand-base64-64

# ── Logging ──────────────────────────────────────────────────────────────────
RICE_LOG_LEVEL=INFO

# ── CORS ─────────────────────────────────────────────────────────────────────
# Origines autorisées (séparées par des virgules)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Semantic Model (optionnel) ───────────────────────────────────────────────
# Chemin vers le modèle sémantique vendu dans l'image Docker
# RICE_SEMANTIC_MODEL=/opt/models/semantic
