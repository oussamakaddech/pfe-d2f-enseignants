# =============================================================================
# D2F Predictive Analytics Service - variables d'environnement
# Copier vers .env et renseigner les valeurs (aucun secret en dur dans le code)
# =============================================================================

# -- Application --------------------------------------------------------------
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO

# -- Base de donnees (schema analyse en ecriture, lecture cross-schemas) ------
DATABASE_URL=postgresql://app_user_analyse:CHANGE_ME@db.dsi.local:5432/d2f
DB_CONNECT_TIMEOUT=5

# -- Securite JWT (HS512 - partage avec le SI D2F) ---------------------------
JWT_SECRET=CHANGE_ME_do_not_use_default
JWT_ALGORITHM=HS512
JWT_AUTH_ENABLED=true

# -- CORS ---------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# -- Pagination ---------------------------------------------------------------
PAGINATION_DEFAULT_SIZE=20
PAGINATION_MAX_SIZE=100

# -- Seuils metier (externalises - cf. spec algorithme sec.10) ------------------
SEUIL_GAP_CRITIQUE=0.75
SEUIL_GAP_HAUTE=0.5
SEUIL_GAP_MOYENNE=0.25
# Bornes de classement du score de risque (0..100) : >=HIGH -> CRITIQUE,
# >=SEVERE -> ELEVE, >=MEDIUM -> MOYEN, sinon FAIBLE.
# RISK_THRESHOLD_HIGH pilote aussi le declenchement des alertes.
RISK_THRESHOLD_HIGH=70
RISK_THRESHOLD_SEVERE=55
RISK_THRESHOLD_MEDIUM=30
COLLECTIVE_MIN_TEACHERS=3
STAGNATION_REF_MONTHS=12
ENGAGEMENT_REF_DAYS=180

# -- Classement des recommandations de formation -----------------------------
# Ponderation du score de pertinence d'une formation (defaut : 70/20/10).
RANKING_WEIGHT_CONTENT=0.70
RANKING_WEIGHT_QUALITY=0.20
RANKING_WEIGHT_RECENCY=0.10
# Fenetre de decroissance de la recence, en jours, apres la fin d'une formation.
RANKING_RECENCY_LOOKBACK_DAYS=365
# Echelle de notation des evaluations de formation (notes sur 5 par defaut).
RANKING_EVAL_SCALE_MAX=5.0
# Part du score ML dans le melange heuristique/ML (0.0 = heuristique pure).
RANKING_ML_BLEND_RATIO=0.30

# -- Ponderations score de risque (JSON - somme quelconque, normalisee) ------
RISK_WEIGHTS={"stagnation":0.25,"decline":0.20,"attendance":0.20,"low_eval":0.15,"repeated_need":0.10,"low_engagement":0.10}

# -- ML (artefacts locaux, jamais de cloud) -----------------------------------
MODELS_DIR=ml/artifacts
GAP_MODEL_ARTIFACT=gap_predictor.joblib

# -- Cache d'analyse ----------------------------------------------------------
ANALYSIS_CACHE_TTL_HOURS=24

# -- Sprint 2 : detection de besoins de formation -----------------------------
NEED_DETECTION_THRESHOLD=0.5
NEED_DETECTION_MIN_TEACHERS=3
ALERT_RECOMPUTE_DAYS=7

# -- Sprint 2 : scheduler (batch periodiques) ---------------------------------
SCHEDULER_ENABLED=false
SCHEDULER_BATCH_INTERVAL_MINUTES=60
SCHEDULER_ALERTS_INTERVAL_MINUTES=15
SCHEDULER_NEEDS_INTERVAL_MINUTES=30

# -- Sprint 2 : consommation d'evenements RabbitMQ (optionnelle) --------------
MESSAGE_BROKER_TYPE=none            # none | rabbitmq
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_EXCHANGE=d2f.events
RABBITMQ_QUEUE=d2f.predictive.analytics
RABBITMQ_ROUTING_KEY=analyse.#
RABBITMQ_CONSUMER_ENABLED=false
THROTTLING_MAX_THREADS=4
