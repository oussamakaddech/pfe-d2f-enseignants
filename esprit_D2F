"""Response envelope for predictive analytics — typed operational states.

Every teacher-specific predictive response must include:
  - teacher_id (canonical ENS)
  - analysis_status: READY | DATA_INCOMPLETE | NOT_FOUND | STALE_DATA | COMPUTATION_FAILED | MODEL_FALLBACK
  - data_source: db | csv_fallback | cache | heuristic | ml_model
  - generated_at: ISO timestamp
  - data_version: version tag for cache invalidation
  - warnings: list of human-readable warnings
  - fallback_reason: optional reason when fallback is used

This module provides builders so every router returns a consistent envelope.
No fake predictive output when source data is incomplete.
"""

from __future__ import annotations

from datetime import datetime, timezone
from typing import Any, Optional

from app.core.id_policy import sanitize_response_id

# Operational states
READY = "READY"
DATA_INCOMPLETE = "DATA_INCOMPLETE"
NOT_FOUND = "NOT_FOUND"
STALE_DATA = "STALE_DATA"
COMPUTATION_FAILED = "COMPUTATION_FAILED"
MODEL_FALLBACK = "MODEL_FALLBACK"

# Data sources
SRC_DB = "db"
SRC_CSV = "csv_fallback"
SRC_CACHE = "cache"
SRC_HEURISTIC = "heuristic"
SRC_ML = "ml_model"


def _now_iso() -> str:
    return datetime.now(timezone.utc).isoformat()


def build_envelope(
    teacher_id: str,
    analysis_status: str,
    *,
    data_source: str = SRC_DB,
    warnings: list[str] | None = None,
    fallback_reason: str | None = None,
    data_version: str = "v1",
    **extra: Any,
) -> dict[str, Any]:
    """Build a standard response envelope for teacher-specific endpoints.

    The caller's payload fields are merged in via **extra.
    """
    id_block = sanitize_response_id(teacher_id)
    envelope: dict[str, Any] = {
        **id_block,
        "analysis_status": analysis_status,
        "data_source": data_source,
        "generated_at": _now_iso(),
        "data_version": data_version,
        "warnings": warnings or [],
    }
    if fallback_reason:
        envelope["fallback_reason"] = fallback_reason
    envelope.update(extra)
    return envelope


def data_incomplete(
    teacher_id: str,
    *,
    missing: list[str],
    data_source: str = SRC_DB,
    data_version: str = "v1",
    **extra: Any,
) -> dict[str, Any]:
    """Return a DATA_INCOMPLETE envelope — no fake predictive output."""
    warnings = [f"Missing data: {m}" for m in missing]
    return build_envelope(
        teacher_id,
        DATA_INCOMPLETE,
        data_source=data_source,
        warnings=warnings,
        fallback_reason="incomplete_source_data",
        data_version=data_version,
        **extra,
    )


def not_found(
    teacher_id: str,
    *,
    data_source: str = SRC_DB,
    data_version: str = "v1",
    **extra: Any,
) -> dict[str, Any]:
    """Return a NOT_FOUND envelope."""
    return build_envelope(
        teacher_id,
        NOT_FOUND,
        data_source=data_source,
        warnings=[f"Teacher {teacher_id} not found in database"],
        data_version=data_version,
        **extra,
    )


def ready(
    teacher_id: str,
    *,
    data_source: str = SRC_DB,
    warnings: list[str] | None = None,
    data_version: str = "v1",
    **extra: Any,
) -> dict[str, Any]:
    """Return a READY envelope with the payload merged in."""
    return build_envelope(
        teacher_id,
        READY,
        data_source=data_source,
        warnings=warnings,
        data_version=data_version,
        **extra,
    )


def model_fallback(
    teacher_id: str,
    *,
    reason: str,
    data_source: str = SRC_HEURISTIC,
    warnings: list[str] | None = None,
    data_version: str = "v1",
    **extra: Any,
) -> dict[str, Any]:
    """Return a MODEL_FALLBACK envelope — transparent about degraded mode."""
    all_warnings = list(warnings or [])
    all_warnings.append(f"ML model fallback: {reason}")
    return build_envelope(
        teacher_id,
        MODEL_FALLBACK,
        data_source=data_source,
        warnings=all_warnings,
        fallback_reason=reason,
        data_version=data_version,
        **extra,
    )